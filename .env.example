APP_NAME=GoSX 3D Studio
PORT=8080
# Session cookies and CSRF tokens both derive from this value. The Studio
# refuses to sign with this published placeholder: development generates a
# random per-process secret instead, and GOSX_ENV=production fails to start.
SESSION_SECRET=replace-with-a-local-development-secret
GOSX_ENV=development
STUDIO_PROJECT_DIR=.studio

# Windows builds launch the native GoSX Desktop host by default. Set this only
# for a server deployment or automated server probe.
STUDIO_SERVER_ONLY=0
STUDIO_VERSION=0.1.0

# MSIX release identity. Signing additionally requires GOSX_CODESIGN_CERT,
# GOSX_CODESIGN_KEY, and the Windows SDK MakeAppx/SignTool binaries.
GOSX_MSIX_IDENTITY=m31labs.GoSX3DStudio
GOSX_MSIX_DISPLAY_NAME=GoSX 3D Studio
GOSX_MSIX_DESCRIPTION=Go-native 3D scene, animation, game, and simulation workbench
GOSX_MSIX_BROAD_FILE_SYSTEM_ACCESS=1
STUDIO_ACTION_TOKEN=replace-with-a-local-action-token
